{
  "name": "neurowork",
  "version": "0.1.0",
  "private": true,
  "description": "NeuroWork — plataforma web de recrutamento neuroinclusivo (primeira versão: front-end com dados de exemplo)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec tests/neurowork.test.ts",
    "test:regras": "npx --yes firebase-tools@14 emulators:exec --only auth,firestore --project demo-neurowork \"node --import tsx --test --test-reporter=spec tests/regras-firestore.test.ts\"",
    "db:popular": "node --import tsx scripts/popular-banco.ts",
    "db:emulador": "npx --yes firebase-tools@14 emulators:exec --only auth,firestore --project demo-neurowork \"npm run db:popular\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "lucide-react": "^0.475.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
