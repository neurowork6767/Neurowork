# Copie este arquivo para .env.local e preencha com os dados do seu projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → App da Web → Configuração do SDK).
#
# Sem estas variáveis, o NeuroWork roda no MODO DEMONSTRAÇÃO, com dados de exemplo no navegador.
#
# Estas chaves identificam o projeto e ficam visíveis no navegador; isso é esperado.
# Quem protege os dados são as regras do arquivo firestore.rules.
# Nunca coloque aqui chaves de conta de serviço (service account) ou senhas.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Só para o script "npm run db:popular", que cria o banco com os dados de exemplo.
# Estas variáveis não começam com NEXT_PUBLIC_, então nunca vão para o navegador.
# É a conta da empresa de exemplo no Firebase: escolha uma senha só sua
# (mínimo de 8 caracteres, com letras e números).
SEED_EMPRESA_EMAIL=
SEED_EMPRESA_SENHA=
