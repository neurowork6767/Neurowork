rules_version = '2';

// Regras de segurança do Cloud Firestore do NeuroWork.
// Elas rodam no servidor do Google: mesmo que alguém altere o código do site,
// não consegue ler ou mudar dados fora do que está permitido aqui.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Empresa = usuário com e-mail e senha (candidatos entram de forma anônima)
    function empresaLogada() {
      return logado() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function ehDono(empresaId) {
      return empresaLogada() && request.auth.uid == empresaId;
    }

    // A alteração mexe apenas nos campos listados?
    function alteraApenas(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function texto(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    function vaga(vagaId) {
      return get(/databases/$(database)/documents/vagas/$(vagaId)).data;
    }

    // ---------- Empresas: cada empresa só vê e altera o próprio cadastro ----------
    match /empresas/{empresaId} {
      allow read: if ehDono(empresaId);

      allow create: if ehDono(empresaId)
        && request.resource.data.keys().hasOnly(['nome', 'cnpj', 'email', 'telefone', 'responsavel', 'plano', 'criadaEm'])
        && texto(request.resource.data.nome, 120)
        && texto(request.resource.data.cnpj, 18)
        && request.resource.data.plano == null;

      // CNPJ e e-mail não podem ser trocados pelo site
      allow update: if ehDono(empresaId)
        && alteraApenas(['nome', 'responsavel', 'telefone', 'plano'])
        && texto(request.resource.data.nome, 120)
        && (request.resource.data.plano == null || request.resource.data.plano in ['basic', 'pro', 'enterprise']);

      allow delete: if false;
    }

    // ---------- Vagas ----------
    match /vagas/{vagaId} {
      // Vaga aberta é pública (página do candidato); a empresa vê todas as suas
      allow read: if resource.data.status == 'aberta' || ehDono(resource.data.empresaId);

      allow create: if ehDono(request.resource.data.empresaId)
        && request.resource.data.status == 'aberta'
        && texto(request.resource.data.titulo, 80)
        && request.resource.data.etapas.size() == 0;

      allow update: if ehDono(resource.data.empresaId)
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.status in ['aberta', 'encerrada']
        && texto(request.resource.data.titulo, 80);

      allow delete: if false;
    }

    // ---------- Candidaturas ----------
    match /candidaturas/{candidaturaId} {
      // A empresa dona da vaga e o próprio candidato podem ler
      allow read: if ehDono(resource.data.empresaId)
        || (logado() && resource.data.candidatoUid == request.auth.uid);

      // O candidato (anônimo) cria a candidatura só em vaga aberta e com o aceite da LGPD.
      // A lista fechada de campos impede gravar qualquer dado extra, como diagnóstico.
      allow create: if logado()
        && request.resource.data.keys().hasOnly([
          'vagaId', 'empresaId', 'candidatoUid', 'nome', 'email', 'telefone', 'cidade',
          'curriculo', 'portfolio', 'certificados', 'portfolioLink', 'adaptacoes', 'consentimentoLgpd',
          'status', 'respostas', 'avaliacaoConcluida', 'ajustesCompartilhados', 'enviadaEm'
        ])
        && request.resource.data.candidatoUid == request.auth.uid
        && request.resource.data.status == 'nova'
        && request.resource.data.consentimentoLgpd == true
        && request.resource.data.ajustesCompartilhados.size() == 0
        && request.resource.data.certificados.size() <= 5
        && texto(request.resource.data.nome, 120)
        && texto(request.resource.data.adaptacoes, 500)
        && vaga(request.resource.data.vagaId).status == 'aberta'
        && vaga(request.resource.data.vagaId).empresaId == request.resource.data.empresaId;

      // Empresa: só altera o status. Candidato: só responde, até enviar a avaliação.
      allow update: if (
          ehDono(resource.data.empresaId)
          && alteraApenas(['status'])
          && request.resource.data.status in ['nova', 'em_analise', 'aprovado', 'reprovado']
        ) || (
          logado()
          && resource.data.candidatoUid == request.auth.uid
          && resource.data.avaliacaoConcluida == false
          && alteraApenas(['respostas', 'avaliacaoConcluida', 'ajustesCompartilhados'])
          && request.resource.data.ajustesCompartilhados.size() <= 10
        );

      // Direito de exclusão (LGPD): a empresa da vaga ou o próprio candidato podem apagar
      allow delete: if ehDono(resource.data.empresaId)
        || (logado() && resource.data.candidatoUid == request.auth.uid);

      // ---------- PDFs da candidatura (currículo, portfólio e certificados) ----------
      // Cada PDF fica num documento separado, com o conteúdo em base64 (até 700 KB por arquivo).
      match /arquivos/{arquivoId} {
        function candidatura() {
          return get(/databases/$(database)/documents/candidaturas/$(candidaturaId)).data;
        }

        // Situação da candidatura DEPOIS da gravação: o PDF vai no mesmo envio da candidatura
        function candidaturaEnviada() {
          return getAfter(/databases/$(database)/documents/candidaturas/$(candidaturaId)).data;
        }

        // Só aceita os arquivos que a própria candidatura lista (no máximo 7: currículo, portfólio e 5 certificados)
        function listado(c) {
          return c.curriculo.get('id', '') == arquivoId
            || (c.portfolio != null && c.portfolio.get('id', '') == arquivoId)
            || (c.certificados.size() > 0 && c.certificados[0].get('id', '') == arquivoId)
            || (c.certificados.size() > 1 && c.certificados[1].get('id', '') == arquivoId)
            || (c.certificados.size() > 2 && c.certificados[2].get('id', '') == arquivoId)
            || (c.certificados.size() > 3 && c.certificados[3].get('id', '') == arquivoId)
            || (c.certificados.size() > 4 && c.certificados[4].get('id', '') == arquivoId);
        }

        // A empresa da vaga e o próprio candidato podem abrir
        allow read: if ehDono(candidatura().empresaId)
          || (logado() && candidatura().candidatoUid == request.auth.uid);

        allow create: if logado()
          && candidaturaEnviada().candidatoUid == request.auth.uid
          && candidaturaEnviada().status == 'nova'
          && listado(candidaturaEnviada())
          && request.resource.data.keys().hasOnly(['nome', 'tipo', 'tamanho', 'conteudo', 'enviadoEm'])
          && request.resource.data.tipo in ['curriculo', 'portfolio', 'certificado']
          && texto(request.resource.data.nome, 200)
          && request.resource.data.tamanho is int
          && request.resource.data.tamanho <= 716800
          && texto(request.resource.data.conteudo, 960000);

        // O PDF enviado não pode ser trocado
        allow update: if false;

        // Apagado junto com a candidatura (LGPD)
        allow delete: if ehDono(candidatura().empresaId)
          || (logado() && candidatura().candidatoUid == request.auth.uid);
      }
    }
  }
}
